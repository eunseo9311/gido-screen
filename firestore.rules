rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 담당자 이메일. Firebase 콘솔에서 만든 담당자 계정 이메일로 바꾸세요. 여러 명이면 쉼표로 추가합니다.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['eunseosong4916@gmail.com'];
    }

    match /prayers/{id} {
      // 누구나 올릴 수 있지만, 항상 '확인 대기' 상태로만 들어갑니다.
      allow create: if request.resource.data.keys().hasOnly(['text', 'name', 'status', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      // 송출 화면은 승인된 기도만 읽습니다. 대기·숨김 기도는 담당자만 봅니다.
      allow read: if resource.data.status == 'approved' || isAdmin();

      allow update, delete: if isAdmin();
    }
  }
}
